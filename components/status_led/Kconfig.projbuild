menu "Status LED"

    choice STATUS_LED_TYPE
        prompt "Status LED type"
        default STATUS_LED_NONE
        help
            Optional RGB LED that shows the client state:
              white   booting
              amber   (blinking) connecting to WiFi / Ethernet
              magenta (blinking) no WiFi credentials stored yet
              blue    network up, looking for / connecting to the snapserver
              green   connected to the snapserver, idle or muted (dim)
              green   playing (bright)
              red     (blinking) fatal error (audio board init failed)
              cyan    (blinking) rescue / setup access point

        config STATUS_LED_NONE
            bool "None"
        config STATUS_LED_WS2812
            bool "Addressable WS2812 / SK6812 (single data pin)"
        config STATUS_LED_RGB_GPIO
            bool "Discrete RGB LED on three GPIOs"
    endchoice

    config STATUS_LED_WS2812_GPIO
        int "WS2812 data GPIO"
        depends on STATUS_LED_WS2812
        range -1 48
        default -1
        help
            GPIO connected to DIN of the first addressable LED.

    config STATUS_LED_WS2812_COUNT
        int "Number of LEDs in the chain"
        depends on STATUS_LED_WS2812
        range 1 16
        default 1

    config STATUS_LED_R_GPIO
        int "Red GPIO"
        depends on STATUS_LED_RGB_GPIO
        range -1 48
        default -1
    config STATUS_LED_G_GPIO
        int "Green GPIO"
        depends on STATUS_LED_RGB_GPIO
        range -1 48
        default -1
    config STATUS_LED_B_GPIO
        int "Blue GPIO"
        depends on STATUS_LED_RGB_GPIO
        range -1 48
        default -1
    config STATUS_LED_ACTIVE_LOW
        bool "LED is active low (common anode)"
        depends on STATUS_LED_RGB_GPIO
        default n

    config STATUS_LED_BRIGHTNESS
        int "Brightness (WS2812 only, 1-255)"
        depends on STATUS_LED_WS2812
        range 1 255
        default 40

endmenu
